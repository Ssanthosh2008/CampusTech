rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validItem(data) {
      return data.keys().hasOnly([
        'type', 'title', 'description', 'category', 'location', 'date',
        'contact', 'imageData', 'userId', 'userName', 'status', 'createdAt'
      ])
      && data.type in ['lost', 'found']
      && data.title is string && data.title.size() > 0 && data.title.size() <= 100
      && data.description is string && data.description.size() > 0 && data.description.size() <= 1000
      && data.category is string && data.category.size() > 0 && data.category.size() <= 40
      && data.location is string && data.location.size() > 0 && data.location.size() <= 120
      && data.date is string && data.date.size() <= 10
      && data.contact is string && data.contact.size() > 0 && data.contact.size() <= 180
      && data.imageData is string && data.imageData.size() <= 140000
      && data.userId is string && data.userName is string && data.userName.size() <= 180
      && data.status in ['open', 'resolved']
      && data.createdAt is timestamp;
    }

    match /items/{itemId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && validItem(request.resource.data);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && validItem(request.resource.data);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
